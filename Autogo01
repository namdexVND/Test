-- ==================== LOGIC TELEPORT BẰNG RAYCAST DƯỚI ĐẤT ====================
local autoFarmEnabled = false

local function getCustomGroundPosition(treeObj)
	local treePos = nil
	if treeObj:IsA("Model") then
		treePos = treeObj:GetPivot().Position
	elseif treeObj:IsA("BasePart") then
		treePos = treeObj.Position
	end

	if not treePos then return nil end

	local offsetY = tonumber(inputY.Text) or 3.2
	local offsetSide = tonumber(inputSide.Text) or 3

	local checkPos = treePos + Vector3.new(offsetSide, 10, 0)
	
	local raycastParams = RaycastParams.new()
	raycastParams.FilterType = Enum.RaycastFilterType.Exclude
	
	local char = player.Character
	if char then
		raycastParams.FilterDescendantsInstances = {char, treeObj}
	end

	local rayResult = Workspace:Raycast(checkPos, Vector3.new(0, -50, 0), raycastParams)

	if rayResult then
		return CFrame.new(rayResult.Position + Vector3.new(0, offsetY, 0))
	else
		return CFrame.new(treePos + Vector3.new(offsetSide, offsetY, 0))
	end
end

local function clickPromptButton()
	local pGui = player:FindFirstChild("PlayerGui")
	if not pGui then return false end

	local promptGui = pGui:FindFirstChild("ProximityPrompts")
	if not promptGui then return false end

	local promptFrame = promptGui:FindFirstChild("Prompt")
	if not promptFrame then return false end

	local textBtn = promptFrame:FindFirstChild("TextButton")
	if not textBtn then return false end

	if firesignal then
		firesignal(textBtn.MouseButton1Click)
		return true
	elseif getconnections then
		for _, conn in ipairs(getconnections(textBtn.MouseButton1Click)) do
			conn:Fire()
		end
		return true
	end
	return false
end

toggleFarmBtn.MouseButton1Click:Connect(function()
	autoFarmEnabled = not autoFarmEnabled

	if autoFarmEnabled then
		toggleFarmBtn.Text = "🟢 Auto Teleport"
		toggleFarmBtn.BackgroundColor3 = Color3.fromRGB(0, 170, 80)
		statusBox.Text = "🚀 Đang chạy vòng lặp farm cây nho..."

		task.spawn(function()
			while autoFarmEnabled do
				local character = player.Character or player.CharacterAdded:Wait()
				local rootPart = character:FindFirstChild("HumanoidRootPart")
				local jobNhoFolder = Workspace:FindFirstChild("job nho")

				if not jobNhoFolder then
					statusBox.Text = "⚠️ Lỗi: Không thấy thư mục 'job nho'!"
					break
				end

				local treeList = {}
				for _, child in ipairs(jobNhoFolder:GetChildren()) do
					if child.Name == "cây nho" then
						table.insert(treeList, child)
					end
				end

				if #treeList == 0 then
					statusBox.Text = "⚠️ Không tìm thấy cây nho nào!"
					task.wait(2)
				else
					for index, tree in ipairs(treeList) do
						if not autoFarmEnabled then break end

						if rootPart and character then
							local targetCFrame = getCustomGroundPosition(tree)
							if targetCFrame then
								rootPart.Anchored = true
								rootPart.CFrame = targetCFrame
								task.wait(0.1)
								rootPart.Anchored = false

								statusBox.Text = string.format("🌲 [%d/%d] Tới: %s\n⏳ Đang bấm nút...", index, #treeList, tree.Name)
								
								task.wait(0.2)
								clickPromptButton()
							end
						end

						task.wait(1.2)
					end
				end

				task.wait(0.5)
			end
		end)
	else
		toggleFarmBtn.Text = "🔴 Auto Teleport"
		toggleFarmBtn.BackgroundColor3 = Color3.fromRGB(200, 50, 50)
		statusBox.Text = "🛑 Đã dừng Auto Farm Nho."
	end
end)
