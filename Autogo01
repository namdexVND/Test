-- ==================== LOGIC PLAYER ESP & ANTI-PLAYER (KHOẢNG CÁCH THOÁT) ====================
local espFolder = Instance.new("Folder")
espFolder.Name = "VND_ESP_Folder"
espFolder.Parent = playerGui

task.spawn(function()
	while true do
		task.wait(0.2)
		
		if _G.PlayerESPEnabled then
			pcall(function()
				local char = player.Character
				local hrp = char and char:FindFirstChild("HumanoidRootPart")
				local maxSafeDist = tonumber(inputDist.Text) or 20 -- Lấy số mét từ ô nhập trên UI
				
				-- Xóa BillboardGui cũ để cập nhật mới
				espFolder:ClearAllChildren()

				for _, otherPlayer in ipairs(Players:GetPlayers()) do
					if otherPlayer ~= player and otherPlayer.Character then
						local oChar = otherPlayer.Character
						local oHrp = oChar:FindFirstChild("HumanoidRootPart")
						local oHead = oChar:FindFirstChild("Head")

						if oHrp and oHead then
							local dist = hrp and (hrp.Position - oHrp.Position).Magnitude or 9999

							-- 1. KIỂM TRA TỰ ĐỘNG THOÁT NẾU NGƯỜI CHƠI KHÁC ĐẾN QUÁ GẦN
							if hrp and dist <= maxSafeDist then
								statusBox.Text = string.format("⚠️ CẢNH BÁO: Người chơi [%s] cách bạn %.1fm! Đang thoát game...", otherPlayer.Name, dist)
								task.wait(0.1)
								-- Lệnh thoát game bảo vệ tài khoản ngay lập tức
								pcall(function()
									game:Shutdown() -- Hoặc dùng TeleportService đá về server khác nếu game hỗ trợ
								end)
								player:Kick("\n[VND Hub Anti-Player]\nPhát hiện người chơi khác đến gần dưới " .. maxSafeDist .. "m! Đã tự động ngắt kết nối.")
								return
							end

							-- 2. TẠO BILLBOARD ESP HIỂN THỊ TÊN & KHOẢNG CÁCH TRÊN ĐẦU
							local bill = Instance.new("BillboardGui")
							bill.Name = "ESP_" .. otherPlayer.Name
							bill.Adornee = oHead
							bill.Size = UDim2.new(0, 200, 0, 50)
							bill.StudsOffset = Vector3.new(0, 2.2, 0)
							bill.AlwaysOnTop = true
							bill.Parent = espFolder

							local textLabel = Instance.new("TextLabel")
							textLabel.Size = UDim2.new(1, 0, 1, 0)
							textLabel.BackgroundTransparency = 1
							textLabel.TextColor3 = Color3.fromRGB(0, 255, 120)
							textLabel.TextStrokeTransparency = 0 -- Viền đen chữ dễ nhìn
							textLabel.TextSize = 13
							textLabel.Font = Enum.Font.GothamBold
							textLabel.Text = string.format("👤 %s\n📏 [%.1fm]", otherPlayer.Name, dist)
							textLabel.Parent = bill
						end
					end
				end
			end)
		else
			espFolder:ClearAllChildren()
		end
	end
end)

